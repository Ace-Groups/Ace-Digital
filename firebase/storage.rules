rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function authUserId() {
      return int(request.auth.token.userId);
    }

    function ownsStorage(userId) {
      return signedIn() && int(userId) == authUserId();
    }

    function isChannelMember(channelId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/channel_member_index/$(channelId + '_' + authUserId()));
    }

    // Direct Storage reads of HR files. The API still enforces employees:read
    // when it streams a file. Custom tokens include the app role claim.
    function canReadHrDocuments() {
      return signedIn() && (
        request.auth.token.role == "hr" ||
        request.auth.token.role == "management" ||
        request.auth.token.role == "super_admin"
      );
    }

    match /channels/{channelId}/{uploadId}/{fileName} {
      allow read: if signedIn() && isChannelMember(int(channelId));
      allow write: if signedIn()
        && isChannelMember(int(channelId))
        && request.resource.size < 50 * 1024 * 1024;
    }

    /** Published employee ID cards — public read for email embeds; writes via Admin SDK only. */
    match /id-cards/{employeeCode}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // HR onboarding documents. Writes are Admin SDK only.
    match /hr-documents/{uploadId}/{fileName} {
      allow read: if canReadHrDocuments();
      allow write: if false;
    }

    function isPeopleManager() {
      return signedIn() && (
        request.auth.token.role == "hr" ||
        request.auth.token.role == "management" ||
        request.auth.token.role == "super_admin"
      );
    }

    match /attendance-selfies/{userId}/{fileName} {
      allow read: if ownsStorage(userId) || isPeopleManager();
      allow write: if ownsStorage(userId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
      allow delete: if false;
    }
  }
}
