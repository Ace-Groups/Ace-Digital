rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authUserId() {
      return int(request.auth.token.userId);
    }

    function isChannelMember(channelId) {
      return signedIn()
        && exists(/databases/$(database)/documents/channel_member_index/$(channelId + '_' + authUserId()));
    }

    match /channel_member_index/{docId} {
      allow read: if signedIn() && resource.data.userId == authUserId();
    }

    match /messages/{messageId} {
      allow read: if signedIn() && isChannelMember(resource.data.channelId);
      allow write: if false;
    }

    match /channels/{channelId} {
      allow read: if signedIn() && isChannelMember(int(channelId));
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && isChannelMember(int(channelId));
        allow write: if false;
      }
    }

    match /users/{userId}/user_tokens/{tokenId} {
      allow read: if signedIn() && authUserId() == int(userId);
      allow write: if false;
    }

    match /push_outbox/{outboxId} {
      allow read, write: if false;
    }

    function isAttendanceAdmin() {
      return signedIn() && request.auth.token.role in ["super_admin", "management", "hr", "finance"];
    }

    function isOwnAttendanceDay(dayId) {
      return signedIn() && int(dayId.split('_')[0]) == authUserId();
    }

    match /attendance_settings/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /attendance_days/{dayId} {
      allow read: if isOwnAttendanceDay(dayId) || isAttendanceAdmin();
      allow write: if false;

      match /audit/{auditId} {
        allow read: if isOwnAttendanceDay(dayId) || isAttendanceAdmin();
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
