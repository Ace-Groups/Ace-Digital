# Vite production build for Firebase Hosting site ace-digital-int-12345.
# Leave VITE_API_BASE_URL unset so the SPA calls same-origin /api.
# Hosting rewrites /api to Cloud Run. Chat uses Firestore listeners when the
# web SDK values below are set. Until then, chat polls. See docs/DEPLOY_CLOUD_RUN.md.
#
# Create the web app once, then paste apps:sdkconfig output into these vars.
# Do not reuse the old ace-digital-os web API key, app id, or sender id.
#   npx firebase-tools@latest apps:create WEB "Ace Digital Int" --project ace-digital-int-12345
#   npx firebase-tools@latest apps:sdkconfig WEB --project ace-digital-int-12345

VITE_FIREBASE_CHAT=true
VITE_FIREBASE_PROJECT_ID=ace-digital-int-12345
VITE_FIREBASE_AUTH_DOMAIN=ace-digital-int-12345.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=ace-digital-int-12345.firebasestorage.app
VITE_FIREBASE_DATABASE_URL=https://ace-digital-int-12345-default-rtdb.asia-southeast1.firebasedatabase.app
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_VAPID_KEY=
BASE_PATH=/
