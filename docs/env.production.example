# Vite production build for Firebase Hosting
# Leave VITE_API_BASE_URL unset so the SPA calls same-origin /api.
# Hosting rewrites /api and /socket.io to Cloud Run. See docs/DEPLOY_CLOUD_RUN.md.

VITE_FIREBASE_CHAT=true
BASE_PATH=/
# VITE_SOCKET_URL=   # only if Hosting cannot proxy the WebSocket upgrade
